model User {
  id                        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId            String?            @map("organization_id") @db.Uuid
  email                     String
  emailNormalized           String             @map("email_normalized") @db.Text
  passwordHash              String?            @map("password_hash")
  fullName                  String             @map("full_name")
  firstName                 String             @map("first_name") @db.Text
  avatarUrl                 String?            @map("avatar_url")
  coverImageUrl             String?            @map("cover_image_url")
  phone                     String?
  phoneVerified             Boolean            @default(false) @map("phone_verified")
  status                    UserStatus         @default(pending)
  userType                  UserType           @map("user_type")
  emailVerified             Boolean            @default(false) @map("email_verified")
  emailVerifiedAt           DateTime?          @map("email_verified_at") @db.Timestamptz
  twoFactorEnabled          Boolean            @default(false) @map("two_factor_enabled")
  twoFactorSecret           String?            @map("two_factor_secret")
  failedLoginCount          Int                @default(0) @map("failed_login_count")
  lockedUntil               DateTime?          @map("locked_until") @db.Timestamptz
  passwordChangedAt         DateTime?          @map("password_changed_at") @db.Timestamptz
  mustChangePassword        Boolean            @default(false) @map("must_change_password")
  lastLoginAt               DateTime?          @map("last_login_at") @db.Timestamptz
  lastLoginIp               String?            @map("last_login_ip") @db.Inet
  lastSeenAt                DateTime?          @map("last_seen_at") @db.Timestamptz
  locale                    String?            @map("locale") @db.Char(5)
  timezone                  String?            @map("timezone")
  deactivatedAt             DateTime?          @map("deactivated_at") @db.Timestamptz
  deactivatedReason         String?            @map("deactivated_reason")
  version                   Int                @default(1)
  metadata                  Json               @default("{}")
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                 DateTime?          @map("deleted_at") @db.Timestamptz
  // Relations
  organization              Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  language                  Language?          @relation(fields: [locale], references: [code])
  timezoneRelation          Timezone?          @relation(fields: [timezone], references: [name])
  searchQueries             SearchQuery[]
  reversedModerationActions ModerationAction[] @relation("ModerationReversedBy")
  announcementReads         AnnouncementRead[]
  pageViews                 PageView[]

  orgsVerified               Organization[]           @relation("OrgVerifiedBy")
  orgsCreated                Organization[]           @relation("OrgCreatedBy")
  orgSettingsUpdated         OrgSetting[]             @relation("OrgSettingUpdatedBy")
  invitationsSent            OrgInvitation[]          @relation("InvitedBy")
  sessions                   UserSession[]
  oauthAccounts              UserOAuthAccount[]
  passwordResets             PasswordResetToken[]
  emailVerifications         EmailVerificationToken[]
  backupCodes                TwoFactorBackupCode[]
  pushSubscriptions          PushSubscription[]
  userRoles                  UserRole[]
  permissionOverrides        UserPermissionOverride[]
  alumniProfile              AlumniProfile?
  studentProfile             StudentProfile?
  verificationRequests       VerificationRequest[]
  verificationReviewed       VerificationRequest[]    @relation("VerificationReviewedBy")
  sentConnections            Connection[]             @relation("Requester")
  receivedConnections        Connection[]             @relation("Recipient")
  mentorshipAsStudent        MentorshipRequest[]      @relation("StudentMentorship")
  mentorshipAsAlumni         MentorshipRequest[]      @relation("AlumniMentorship")
  mentorshipResponses        MentorshipRequest[]      @relation("MentorshipRespondedBy")
  mentorshipCancelled        MentorshipRequest[]      @relation("MentorshipCancelledBy")
  mentorshipSessionsAsMentor MentorshipSession[]      @relation("MentorSessions")
  mentorshipSessionsAsMentee MentorshipSession[]      @relation("MenteeSessions")
  posts                      Post[]
  postsPinned                Post[]                   @relation("PostPinnedBy")
  comments                   PostComment[]
  reactions                  Reaction[]
  chatThreadsCreated         ChatThread[]             @relation("ChatThreadCreatedBy")
  threadMemberships          ChatThreadMember[]
  messages                   Message[]
  messagesPinned             Message[]                @relation("MessagePinnedBy")
  eventsOrganized            Event[]                  @relation("EventOrganizer")
  eventRegistrations         EventRegistration[]
  eventCheckins              EventRegistration[]      @relation("EventCheckedInBy")
  jobPostings                JobPosting[]
  jobApplications            JobApplication[]
  jobBookmarks               JobBookmark[]
  groupsCreated              Group[]                  @relation("GroupCreatedBy")
  groupMemberships           GroupMember[]
  groupInvitations           GroupMember[]            @relation("GroupInvitedBy")
  groupBans                  GroupMember[]            @relation("GroupBannedBy")
  channelMessages            ChannelMessage[]
  notifications              Notification[]
  notificationPrefs          NotificationPreference[]
  surveysCreated             Survey[]
  surveyResponses            SurveyResponse[]
  pollsCreated               Poll[]
  pollVotes                  PollVote[]
  announcementsAuthored      Announcement[]
  reportsMade                ContentReport[]          @relation("ReportedBy")
  reportsReviewed            ContentReport[]          @relation("ReportReviewedBy")
  moderationActions          ModerationAction[]
  blocksMade                 UserBlock[]              @relation("Blocker")
  blocksReceived             UserBlock[]              @relation("Blocked")
  blocklistWordsCreated      BlocklistWord[]
  ipBansCreated              IpBan[]
  webhooksCreated            WebhookEndpoint[]
  auditLogs                  AuditLog[]
  outboxLocks                EventOutbox[]            @relation("OutboxLockedBy")
  userRoleGrants             UserRole[]               @relation("UserRoleGrantedBy")
  userRoleRevokes            UserRole[]               @relation("UserRoleRevokedBy")
  permOverrideGrants         UserPermissionOverride[] @relation("PermOverrideGrantedBy")
  alumniVerifications        AlumniProfile[]          @relation("AlumniVerifiedBy")
  studentVerifications       StudentProfile[]         @relation("StudentVerifiedBy")
  skillEndorsements          SkillEndorsement[]
  tagCreators                Tag[]                    @relation("TagCreator")
  threadRemovers             ChatThreadMember[]       @relation("ThreadMemberRemovedBy")
  messageReads               MessageRead[]
  eventSpeakers              EventSpeaker[]
  jobApplicationReviewers    JobApplication[]         @relation("JobApplicationReviewedBy")

  @@unique([organizationId, emailNormalized])
  @@index([organizationId], map: "idx_users_org_id")
  @@index([organizationId, emailNormalized], map: "idx_users_email_norm")
  @@index([organizationId, status], map: "idx_users_status")
  @@index([organizationId, userType], map: "idx_users_type")
  @@index([organizationId, lastSeenAt(sort: Desc)], map: "idx_users_last_seen")
  @@map("users")
}

model UserSession {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  tokenHash        String      @map("token_hash")
  refreshTokenHash String?     @map("refresh_token_hash")
  deviceType       DeviceType?
  deviceName       String?     @map("device_name")
  browser          String?
  os               String?
  ipAddress        String?     @map("ip_address") @db.Inet
  userAgent        String?     @map("user_agent")
  isActive         Boolean     @default(true) @map("is_active")
  revokedReason    String?     @map("revoked_reason")
  expiresAt        DateTime    @map("expires_at") @db.Timestamptz
  refreshExpiresAt DateTime?   @map("refresh_expires_at") @db.Timestamptz
  lastUsedAt       DateTime    @default(now()) @map("last_used_at") @db.Timestamptz
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId], map: "idx_sessions_user")
  @@index([organizationId], map: "idx_sessions_org")
  @@index([expiresAt], map: "idx_sessions_expiry")
  @@map("user_sessions")
}

model UserOAuthAccount {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id")
  providerEmail  String?       @map("provider_email")
  accessToken    String?       @map("access_token")
  refreshToken   String?       @map("refresh_token")
  tokenExpiresAt DateTime?     @map("token_expires_at") @db.Timestamptz
  scopes         String[]
  providerData   Json          @default("{}") @map("provider_data")
  isPrimary      Boolean       @default(false) @map("is_primary")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId], map: "idx_oauth_user")
  @@index([provider, providerUserId], map: "idx_oauth_provider")
  @@map("user_oauth_accounts")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  ipAddress String?   @map("ip_address") @db.Inet
  isUsed    Boolean   @default(false) @map("is_used")
