generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model admin_audit_logs {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_user_id           String?
  organization_id         String?               @db.Uuid
  admin_member_id         String?               @db.Uuid
  action                  String
  action_category         String?               @default("general")
  action_severity         String?               @default("info")
  resource_type           String?
  resource_id             String?               @db.Uuid
  resource_name           String?
  before_snapshot         Json?
  after_snapshot          Json?
  changed_fields          String[]
  change_summary          String?
  request_id              String?
  session_id              String?               @db.Uuid
  ip_address              String?               @db.Inet
  user_agent              String?
  country_code            String?               @db.Char(2)
  region                  String?
  city                    String?
  authentication_method   String?
  authentication_provider String?
  processing_time_ms      Int?
  status                  String?               @default("success")
  error_message           String?
  error_stack             String?
  retention_period_days   Int?                  @default(365)
  is_sensitive            Boolean?              @default(false)
  is_archived             Boolean?              @default(false)
  metadata                Json?                 @default("{}")
  created_at              DateTime?             @default(now()) @db.Timestamptz(6)
  organization_members    organization_members? @relation(fields: [admin_member_id], references: [id], onUpdate: NoAction)
  organizations           organizations?        @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_sessions           user_sessions?        @relation(fields: [session_id], references: [id], onUpdate: NoAction)

  @@index([action], map: "idx_admin_audit_logs_action")
  @@index([action_category], map: "idx_admin_audit_logs_action_category")
  @@index([action_severity], map: "idx_admin_audit_logs_action_severity")
  @@index([admin_user_id], map: "idx_admin_audit_logs_admin_user_id")
  @@index([created_at], map: "idx_admin_audit_logs_created_at")
  @@index([ip_address], map: "idx_admin_audit_logs_ip_address")
  @@index([organization_id], map: "idx_admin_audit_logs_organization_id")
  @@index([resource_id], map: "idx_admin_audit_logs_resource_id")
  @@index([resource_type], map: "idx_admin_audit_logs_resource_type")
  @@index([status], map: "idx_admin_audit_logs_status")
}

