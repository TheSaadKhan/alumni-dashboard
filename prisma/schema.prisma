// ================================================================
// GLOBAL DOMAINS / LOOKUP TABLES
// ================================================================

model Country {
  code     String  @id @map("code") @db.Char(2)
  name     String
  dialCode String? @map("dial_code")
  isActive Boolean @default(true) @map("is_active")

  organizations   Organization[]
  alumniProfiles  AlumniProfile[]
  studentProfiles StudentProfile[]
  events          Event[]
  jobPostings     JobPosting[]

  @@map("countries")
}

model Currency {
  code     String  @id @map("code") @db.Char(3)
  name     String
  symbol   String
  isActive Boolean @default(true) @map("is_active")

  events            Event[]
  jobPostings       JobPosting[]
  jobApplications   JobApplication[]
  subscriptionPlans SubscriptionPlan[]
  subscriptions     Subscription[]
  invoices          Invoice[]

  @@map("currencies")
}

model Timezone {
  name      String  @id
  utcOffset String  @map("utc_offset") // Changed from Interval to String
  isActive  Boolean @default(true) @map("is_active")

  organizations Organization[]
  events        Event[]
  users         User[]

  @@map("timezones")
}

model Language {
  code       String  @id @map("code") @db.Char(5)
  name       String
  nativeName String? @map("native_name")
  isRtl      Boolean @default(false) @map("is_rtl")
  isActive   Boolean @default(true) @map("is_active")

  organizations Organization[]
  users         User[]

  @@map("languages")
}

// ================================================================
// SECTION 1: TENANCY
// ================================================================

model Organization {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String
  name            String
  displayName     String?   @map("display_name")
  legalName       String?   @map("legal_name")
  logoUrl         String?   @map("logo_url")
  faviconUrl      String?   @map("favicon_url")
  website         String?
  description     String?
  establishedYear Int?      @map("established_year")
  countryCode     String?   @map("country_code") @db.Char(2)
  timezone        String?   @map("timezone")
  defaultLanguage String?   @map("default_language") @db.Char(5)
  planTier        PlanTier  @default(free) @map("plan_tier")
  planSeats       Int       @default(100) @map("plan_seats")
  isActive        Boolean   @default(true) @map("is_active")
  isVerified      Boolean   @default(false) @map("is_verified")
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz
  verifiedBy      String?   @map("verified_by") @db.Uuid
  trialEndsAt     DateTime? @map("trial_ends_at") @db.Timestamptz
  onboardingStep  String?   @default("created") @map("onboarding_step")
  customDomain    String?   @unique @map("custom_domain")
  primaryColor    String?   @map("primary_color") @db.Char(7)
  secondaryColor  String?   @map("secondary_color") @db.Char(7)
  settings        Json      @default("{}")
  metadata        Json      @default("{}")
  ssoConfig       Json      @default("{}") @map("sso_config")
  createdBy       String?   @map("created_by") @db.Uuid
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  country          Country?  @relation(fields: [countryCode], references: [code])
  timezoneRelation Timezone? @relation(fields: [timezone], references: [name])
  language         Language? @relation(fields: [defaultLanguage], references: [code])
  verifiedByUser   User?     @relation("OrgVerifiedBy", fields: [verifiedBy], references: [id])
  createdByUser    User?     @relation("OrgCreatedBy", fields: [createdBy], references: [id])

  domains              OrgDomain[]
  settingsRecords      OrgSetting[]
  invitations          OrgInvitation[]
  users                User[]
  userSessions         UserSession[]
  oauthAccounts        UserOAuthAccount[]
  pushSubscriptions    PushSubscription[]
  roles                Role[]
  alumniProfiles       AlumniProfile[]
  studentProfiles      StudentProfile[]
  workHistory          AlumniWorkHistory[]
  educationRecords     ProfileEducation[]
  profileSkills        ProfileSkill[]
  skillEndorsements    SkillEndorsement[]
  verificationRequests VerificationRequest[]
  connections          Connection[]
  mentorshipRequests   MentorshipRequest[]
  mentorshipSessions   MentorshipSession[]
  posts                Post[]
  postAttachments      PostAttachment[]
  tags                 Tag[]
  taggables            Taggable[]
  comments             PostComment[]
  reactions            Reaction[]
  chatThreads          ChatThread[]
  threadMembers        ChatThreadMember[]
  messages             Message[]
  messageAttachments   MessageAttachment[]
  messageReads         MessageRead[]
  events               Event[]
  eventRegistrations   EventRegistration[]
  eventSpeakers        EventSpeaker[]
  jobCategories        JobCategory[]
  jobPostings          JobPosting[]
  jobApplications      JobApplication[]
  jobBookmarks         JobBookmark[]
  groups               Group[]
  groupMembers         GroupMember[]
  groupChannels        GroupChannel[]
  channelMessages      ChannelMessage[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  surveys              Survey[]
  surveyQuestions      SurveyQuestion[]
  surveyResponses      SurveyResponse[]
  polls                Poll[]
  pollVotes            PollVote[]
  announcements        Announcement[]
  announcementReads    AnnouncementRead[]
  contentReports       ContentReport[]
  moderationActions    ModerationAction[]
  userBlocks           UserBlock[]
  blocklistWords       BlocklistWord[]
  ipBans               IpBan[]
  pageViews            PageView[] // Add this line
  dailyStats           DailyOrgStat[]
  searchQueries        SearchQuery[]
  subscriptions        Subscription[]
  invoices             Invoice[]
  webhookEndpoints     WebhookEndpoint[]
  webhookDeliveries    WebhookDelivery[]
  auditLogs            AuditLog[]
  outboxEvents         EventOutbox[]
  featureFlags         FeatureFlag[]
  userRoles            UserRole[]
  permissionOverrides  UserPermissionOverride[]

  @@unique([slug])
  @@index([planTier], map: "idx_orgs_plan")
  @@index([customDomain], map: "idx_orgs_custom_domain")
  @@index([createdAt(sort: Desc)], map: "idx_orgs_created_at")
  @@map("organizations")
}

model OrgDomain {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  domain             String
  isPrimary          Boolean            @default(false) @map("is_primary")
  isVerified         Boolean            @default(false) @map("is_verified")
  verificationToken  String?            @map("verification_token")
  verificationMethod VerificationMethod @default(dns_txt) @map("verification_method")
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz
  lastCheckedAt      DateTime?          @map("last_checked_at") @db.Timestamptz
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([domain])
  @@index([organizationId], map: "idx_org_domains_org")
  @@index([organizationId, isVerified], map: "idx_org_domains_verified")
  @@map("org_domains")
}

model OrgSetting {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  category       String
  settingKey     String   @map("setting_key")
  settingValue   Json     @default("{}") @map("setting_value")
  isEncrypted    Boolean  @default(false) @map("is_encrypted")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedByUser User?        @relation("OrgSettingUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([organizationId, category, settingKey])
  @@index([organizationId, category], map: "idx_org_settings_org")
  @@map("org_settings")
}

model OrgInvitation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  email          String
  roleId         String?      @map("role_id") @db.Uuid
  userType       UserType     @map("user_type")
  invitedBy      String       @map("invited_by") @db.Uuid
  token          String
  status         InviteStatus @default(pending)
  message        String?
  expiresAt      DateTime     @default(dbgenerated("NOW() + INTERVAL '7 days'")) @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime?    @map("accepted_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role          Role?        @relation(fields: [roleId], references: [id])
  invitedByUser User         @relation("InvitedBy", fields: [invitedBy], references: [id])

  @@unique([token])
  @@index([organizationId, status], map: "idx_invites_org")
  @@index([email, status], map: "idx_invites_email")
  @@map("org_invitations")
}

// ================================================================
// SECTION 2: USERS & AUTHENTICATION
