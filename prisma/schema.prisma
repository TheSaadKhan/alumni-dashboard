  organizationId  String            @map("organization_id") @db.Uuid
  jobPostingId    String            @map("job_posting_id") @db.Uuid
  applicantId     String            @map("applicant_id") @db.Uuid
  status          ApplicationStatus @default(submitted)
  coverLetter     String?           @map("cover_letter") @db.Text
  resumeUrl       String?           @map("resume_url")
  portfolioUrl    String?           @map("portfolio_url")
  answers         Json              @default("{}")
  expectedSalary  Decimal?          @map("expected_salary") @db.Decimal(12, 2)
  salaryCurrency  String?           @map("salary_currency") @db.Char(3)
  availableFrom   DateTime?         @map("available_from") @db.Date
  reviewerNote    String?           @map("reviewer_note")
  rejectionReason String?           @map("rejection_reason")
  reviewedBy      String?           @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?         @map("reviewed_at") @db.Timestamptz
  hiredAt         DateTime?         @map("hired_at") @db.Timestamptz
  withdrawnAt     DateTime?         @map("withdrawn_at") @db.Timestamptz
  withdrawnReason String?           @map("withdrawn_reason")
  version         Int               @default(1)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobPosting   JobPosting   @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  applicant    User         @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  reviewer     User?        @relation("JobApplicationReviewedBy", fields: [reviewedBy], references: [id])
  currency     Currency?    @relation(fields: [salaryCurrency], references: [code])

  @@unique([jobPostingId, applicantId])
  @@index([jobPostingId, status], map: "idx_ja_job")
  @@index([applicantId], map: "idx_ja_applicant")
  @@index([organizationId, status], map: "idx_ja_org_status")
  @@map("job_applications")
}

model JobBookmark {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  jobPostingId   String   @map("job_posting_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobPosting   JobPosting   @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobPostingId, userId])
  @@index([userId], map: "idx_jb_user")
  @@map("job_bookmarks")
}

// ================================================================
// SECTION 10: GROUPS & CHANNELS
// ================================================================

model Group {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  createdBy      String          @map("created_by") @db.Uuid
  name           String          @db.Text
  slug           String
  description    String?         @db.Text
  groupType      GroupType       @default(interest) @map("group_type")
  visibility     GroupVisibility @default(public)
  joinPolicy     JoinPolicy      @default(open) @map("join_policy")
  bannerUrl      String?         @map("banner_url")
  avatarUrl      String?         @map("avatar_url")
  memberCount    Int             @default(0) @map("member_count")
  maxMembers     Int?            @map("max_members")
  isFeatured     Boolean         @default(false) @map("is_featured")
  isArchived     Boolean         @default(false) @map("is_archived")
  archivedAt     DateTime?       @map("archived_at") @db.Timestamptz
  rules          String?
  extraData      Json            @default("{}") @map("extra_data")
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User         @relation("GroupCreatedBy", fields: [createdBy], references: [id])

  members  GroupMember[]
  channels GroupChannel[]
  polls    Poll[]

  @@unique([organizationId, slug])
  @@index([organizationId], map: "idx_groups_org")
  @@index([organizationId, groupType], map: "idx_groups_type")
  @@index([organizationId, isFeatured], map: "idx_groups_featured")
  @@map("groups")
}

model GroupMember {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId          String            @map("group_id") @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  role             GroupMemberRole   @default(member)
  status           GroupMemberStatus @default(active)
  isMuted          Boolean           @default(false) @map("is_muted")
  notificationPref NotificationPref  @default(all) @map("notification_pref")
  joinedAt         DateTime          @default(now()) @map("joined_at") @db.Timestamptz
  invitedBy        String?           @map("invited_by") @db.Uuid
  leftAt           DateTime?         @map("left_at") @db.Timestamptz
  bannedAt         DateTime?         @map("banned_at") @db.Timestamptz
  bannedBy         String?           @map("banned_by") @db.Uuid
  banReason        String?           @map("ban_reason")

  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User?        @relation("GroupInvitedBy", fields: [invitedBy], references: [id])
  banner       User?        @relation("GroupBannedBy", fields: [bannedBy], references: [id])

  @@unique([groupId, userId])
  @@index([groupId], map: "idx_gm_group")
  @@index([userId], map: "idx_gm_user")
  @@map("group_members")
}

model GroupChannel {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId        String      @map("group_id") @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  name           String      @db.Text
  slug           String
  description    String?
  channelType    ChannelType @default(text) @map("channel_type")
  isDefault      Boolean     @default(false) @map("is_default")
  isReadonly     Boolean     @default(false) @map("is_readonly")
  isArchived     Boolean     @default(false) @map("is_archived")
  messageCount   Int         @default(0) @map("message_count")
  lastMessageAt  DateTime?   @map("last_message_at") @db.Timestamptz
  sortOrder      Int         @default(0) @map("sort_order")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  messages ChannelMessage[]

  @@unique([groupId, slug])
  @@index([groupId], map: "idx_gc_group")
  @@map("group_channels")
}

model ChannelMessage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId      String    @map("channel_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  replyToId      String?   @map("reply_to_id") @db.Uuid
  content        String    @db.Text
  contentHtml    String?   @map("content_html")
  messageType    String    @default("text") @map("message_type") @db.Text
  isPinned       Boolean   @default(false) @map("is_pinned")
  isEdited       Boolean   @default(false) @map("is_edited")
  editedAt       DateTime? @map("edited_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  channel      GroupChannel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id], onDelete: Restrict)
  replyTo      ChannelMessage?  @relation("ChannelMessageReply", fields: [replyToId], references: [id])
  replies      ChannelMessage[] @relation("ChannelMessageReply")

  @@index([channelId, createdAt(sort: Desc)], map: "idx_cm_channel")
  @@index([senderId], map: "idx_cm_sender")
  @@index([channelId], map: "idx_cm_pinned")
  @@map("channel_messages")
}

// ================================================================
// SECTION 11: NOTIFICATIONS
// ================================================================

model Notification {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  type           String
  category       NotificationCategory
  title          String
  body           String?
  payload        Json                 @default("{}")
  actionUrl      String?              @map("action_url")
  iconUrl        String?              @map("icon_url")
  isRead         Boolean              @default(false) @map("is_read")
  isSeen         Boolean              @default(false) @map("is_seen")
  isEmailed      Boolean              @default(false) @map("is_emailed")
  isPushed       Boolean              @default(false) @map("is_pushed")
  readAt         DateTime?            @map("read_at") @db.Timestamptz
  expiresAt      DateTime?            @map("expires_at") @db.Timestamptz
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_notifs_user_unread")
  @@index([organizationId], map: "idx_notifs_org")
  @@index([expiresAt], map: "idx_notifs_expiry")
  @@map("notifications")
}

model NotificationPreference {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  notificationType String          @map("notification_type")
  inAppEnabled     Boolean         @default(true) @map("in_app_enabled")
  emailEnabled     Boolean         @default(true) @map("email_enabled")
  pushEnabled      Boolean         @default(false) @map("push_enabled")
  digestFrequency  DigestFrequency @default(instant) @map("digest_frequency")
  quietHoursStart  DateTime?       @map("quiet_hours_start") @db.Time
  quietHoursEnd    DateTime?       @map("quiet_hours_end") @db.Time
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, notificationType])
  @@index([userId, organizationId], map: "idx_np_user")
  @@map("notification_preferences")
}

// ================================================================
// SECTION 12: SURVEYS & POLLS
// ================================================================

model Survey {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  createdBy          String         @map("created_by") @db.Uuid
  title              String         @db.Text
  description        String?
  targetAudience     TargetAudience @default(all) @map("target_audience")
  status             SurveyStatus   @default(draft)
  isAnonymous        Boolean        @default(false) @map("is_anonymous")
  allowMultiple      Boolean        @default(false) @map("allow_multiple")
  showProgress       Boolean        @default(true) @map("show_progress")
  randomizeQuestions Boolean        @default(false) @map("randomize_questions")
  thankYouMessage    String?        @map("thank_you_message")
  startsAt           DateTime?      @map("starts_at") @db.Timestamptz
  endsAt             DateTime?      @map("ends_at") @db.Timestamptz
  responseCount      Int            @default(0) @map("response_count")
  maxResponses       Int?           @map("max_responses")
  version            Int            @default(1)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User         @relation(fields: [createdBy], references: [id])

  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@index([organizationId, status], map: "idx_surveys_org")
  @@index([organizationId, startsAt, endsAt], map: "idx_surveys_active")
  @@map("surveys")
}

model SurveyQuestion {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId       String       @map("survey_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  questionText   String       @map("question_text") @db.Text
  questionType   QuestionType @map("question_type")
  isRequired     Boolean      @default(true) @map("is_required")
  sortOrder      Int          @default(0) @map("sort_order")
  description    String?
  config         Json         @default("{}")
  skipLogic      Json         @default("[]") @map("skip_logic")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  survey       Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  options   SurveyQuestionOption[]
  answers   SurveyAnswer[]
  taggables Taggable[]

  @@index([surveyId, sortOrder], map: "idx_sq_survey")
  @@map("survey_questions")
}

model SurveyQuestionOption {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  optionText String   @map("option_text") @db.Text
  value      String?
  sortOrder  Int      @default(0) @map("sort_order")
  isOther    Boolean  @default(false) @map("is_other")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, sortOrder], map: "idx_sqo_question")
  @@map("survey_question_options")
}

model SurveyResponse {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId           String    @map("survey_id") @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  userId             String?   @map("user_id") @db.Uuid
  respondentToken    String?   @unique @map("respondent_token")
  isComplete         Boolean   @default(false) @map("is_complete")
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz
  submittedAt        DateTime? @map("submitted_at") @db.Timestamptz
  ipAddress          String?   @map("ip_address") @db.Inet
  deviceType         String?   @map("device_type")
  timeToCompleteSecs Int?      @map("time_to_complete_secs")

  survey       Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  answers SurveyAnswer[]

  @@index([surveyId, isComplete], map: "idx_sr_survey")
  @@index([userId], map: "idx_sr_user")
  @@map("survey_responses")
}

model SurveyAnswer {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responseId        String    @map("response_id") @db.Uuid
  questionId        String    @map("question_id") @db.Uuid
  selectedOptionIds String[]  @map("selected_option_ids") @db.Uuid
  textValue         String?   @map("text_value")
  numericValue      Decimal?  @map("numeric_value") @db.Decimal
  dateValue         DateTime? @map("date_value") @db.Date
  jsonValue         Json?     @map("json_value")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@index([responseId], map: "idx_sa_response")
  @@index([questionId], map: "idx_sa_question")
  @@map("survey_answers")
}

model Poll {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String         @map("organization_id") @db.Uuid
  createdBy             String         @map("created_by") @db.Uuid
  question              String         @db.Text
  allowMultipleVotes    Boolean        @default(false) @map("allow_multiple_votes")
  showResultsBeforeVote Boolean        @default(false) @map("show_results_before_vote")
  isAnonymous           Boolean        @default(false) @map("is_anonymous")
  visibility            PollVisibility @default(org)
  groupId               String?        @map("group_id") @db.Uuid
  totalVotes            Int            @default(0) @map("total_votes")
  endsAt                DateTime?      @map("ends_at") @db.Timestamptz
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User         @relation(fields: [createdBy], references: [id])
  group        Group?       @relation(fields: [groupId], references: [id])

  options PollOption[]
  votes   PollVote[]

  @@index([organizationId, createdAt(sort: Desc)], map: "idx_polls_org")
  @@map("polls")
}

model PollOption {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pollId     String @map("poll_id") @db.Uuid
  optionText String @map("option_text") @db.Text
  voteCount  Int    @default(0) @map("vote_count")
  sortOrder  Int    @default(0) @map("sort_order")

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId, sortOrder], map: "idx_po_poll")
  @@map("poll_options")
}

model PollVote {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  pollId         String   @map("poll_id") @db.Uuid
  optionId       String   @map("option_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  poll         Poll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option       PollOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, optionId, userId])
  @@index([pollId], map: "idx_pv_poll")
  @@index([userId], map: "idx_pv_user")
  @@map("poll_votes")
}

// ================================================================
// SECTION 13: ANNOUNCEMENTS
// ================================================================

model Announcement {
  id                      String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String               @map("organization_id") @db.Uuid
  authorId                String               @map("author_id") @db.Uuid
  title                   String               @db.Text
  content                 String               @db.Text
  contentHtml             String?              @map("content_html")
  audience                AnnouncementAudience @default(all)
  priority                AnnouncementPriority @default(normal)
  requiresAcknowledgement Boolean              @default(false) @map("requires_acknowledgement")
  bannerUrl               String?              @map("banner_url")
  ctaLabel                String?              @map("cta_label")
  ctaUrl                  String?              @map("cta_url")
  readCount               Int                  @default(0) @map("read_count")
  ackCount                Int                  @default(0) @map("ack_count")
  isPinned                Boolean              @default(false) @map("is_pinned")
  publishAt               DateTime             @default(now()) @map("publish_at") @db.Timestamptz
  expiresAt               DateTime?            @map("expires_at") @db.Timestamptz
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt               DateTime?            @map("deleted_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  reads AnnouncementRead[]

  @@index([organizationId, publishAt(sort: Desc)], map: "idx_ann_org_active")
  @@map("announcements")
}

model AnnouncementRead {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  announcementId String    @map("announcement_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  acknowledged   Boolean   @default(false)
  readAt         DateTime  @default(now()) @map("read_at") @db.Timestamptz
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([announcementId], map: "idx_ar_announcement")
  @@index([userId], map: "idx_ar_user")
  @@map("announcement_reads")
}

// ================================================================
// SECTION 14: MODERATION
// ================================================================

model ContentReport {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  reporterId     String       @map("reporter_id") @db.Uuid
  entityType     String       @map("entity_type") @db.Text
  entityId       String       @map("entity_id") @db.Uuid
  reason         ReportReason
  description    String?      @db.Text
  status         ReportStatus @default(pending)
  autoScore      Int?         @map("auto_score")
  reviewedBy     String?      @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?    @map("reviewed_at") @db.Timestamptz
  resolution     Resolution?  @map("resolution")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reporter     User         @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer     User?        @relation("ReportReviewedBy", fields: [reviewedBy], references: [id])

  moderationActions ModerationAction[]

  @@index([organizationId, status], map: "idx_reports_org")
  @@index([entityType, entityId], map: "idx_reports_entity")
  @@index([reporterId], map: "idx_reports_reporter")
  @@index([organizationId, createdAt], map: "idx_reports_pending")
  @@map("content_reports")
}

model ModerationAction {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  reportId       String?              @map("report_id") @db.Uuid
  moderatorId    String               @map("moderator_id") @db.Uuid
  actionType     ModerationActionType @map("action_type")
  entityType     String               @map("entity_type")
  entityId       String               @map("entity_id") @db.Uuid
  reason         String
  note           String?
  durationHours  Int?                 @map("duration_hours")
  expiresAt      DateTime?            @map("expires_at") @db.Timestamptz
  reversedAt     DateTime?            @map("reversed_at") @db.Timestamptz
  reversedBy     String?              @map("reversed_by") @db.Uuid
  reversedReason String?              @map("reversed_reason")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  report         ContentReport? @relation(fields: [reportId], references: [id])
